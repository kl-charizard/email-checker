# Copy this file to .env and fill in your values.
# Never commit .env — it holds secrets.

# ---- AI (OpenAI-compatible chat completions) ----
# Works with OpenAI, DeepSeek, Groq, Together, Ollama, etc.
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: Anthropic (if you prefer Claude and set AI_PROVIDER=anthropic)
# AI_PROVIDER=openai
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---- Telegram Bot ----
# Create a bot with @BotFather, then put the token here.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Your personal chat id (message @userinfobot to get it)
TELEGRAM_CHAT_ID=123456789

# ---- Email accounts (IMAP) ----
# Gmail: use an App Password (Google Account → Security → 2FA → App passwords)
# Outlook personal: https://account.live.com/proofs/AppPassword
# Outlook work/school: may need admin-enabled IMAP + app password or OAuth.

GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

OUTLOOK_ADDRESS=you@outlook.com
OUTLOOK_APP_PASSWORD=your-app-password
